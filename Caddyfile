# Caddy reverse proxy for the SignSeen staging deployment.
# {$STAGING_DOMAIN} comes from the environment (see .env.staging.example).
# Automatic HTTPS via Let's Encrypt; no cert management needed.

{$STAGING_DOMAIN} {
	handle /api/* {
		reverse_proxy api:8000
	}

	handle /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
