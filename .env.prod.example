# Copy to .env.prod and fill in. NEVER commit .env.prod
# (it's covered by .env* in .gitignore). See docs/self-hosting.md.

# The public hostname for this production deployment.
DOMAIN=signseen.example.com

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=<redacted>

# Django secret key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret

# Public URL of the Next.js app (signing links, password-reset links,
# status-tracking links in emails).
FRONTEND_URL=https://signseen.example.com

# The API's public origin as seen by browsers (same-origin behind Caddy
# in the standard deployment; only needed for split-origin setups).
NEXT_PUBLIC_API_URL=https://signseen.example.com

# --- Stripe billing (optional: leave blank to run free-tier only) -------
# Use LIVE keys in production. Create one Price per plan in the Stripe
# dashboard (premium is $5/mo and $50/yr on the hosted service; set your
# own amounts if you self-host). Register the webhook endpoint
# https://<DOMAIN>/api/billing/webhook/ and put its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_WEBHOOK_SECRET=<redacted>
# Premium storage cap in bytes (default 5 GB when unset).
PREMIUM_STORAGE_BYTES=

# --- Google sign-in (optional: leave blank for password-only login) ----
GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Support chat (optional: GoHighLevel widget id) ----------------------
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Transactional email (optional: unset logs to server console) --------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=<redacted>
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SignSeen <hello@example.com>
