# Copy to .env.staging and fill in. NEVER commit .env.staging
# (it's covered by .env* in .gitignore).

# The public hostname for this staging deployment.
STAGING_DOMAIN=staging.getsignseen.com

# Django secret key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret

# Public URL of the Next.js app (signing links, password-reset links,
# status-tracking links in emails).
FRONTEND_URL=https://staging.getsignseen.com

# --- Stripe billing (optional: leave blank to run free-tier only) -------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Premium storage cap in bytes (default 10 GB when unset).
PREMIUM_STORAGE_BYTES=

# --- Transactional email (optional: unset logs to server console) --------
# Signed-copy delivery to sender/signer + password resets.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SignSeen <hello@getsignseen.com>
